# Embeddings API Configuration
# Supports: LM Studio (local), SambaNova (via TACC), OpenAI, or any OpenAI-compatible endpoint

# Option 1: Local LM Studio (recommended for development)
EMBEDDINGS_API_KEY=local-model
EMBEDDINGS_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDINGS_MODEL=text-embedding-nomic-embed-text-v2-moe

# Option 2: SambaNova via TACC (free when available)
# EMBEDDINGS_API_KEY=your-tacc-api-key
# EMBEDDINGS_BASE_URL=https://tejas.tacc.utexas.edu/v1/your-endpoint-id
# EMBEDDINGS_MODEL=e5-mistral-7B-instruct

# Option 3: OpenAI (production, low cost)
# EMBEDDINGS_API_KEY=sk-your-openai-key
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small

# GTN Pipeline Configuration
GTN_SOURCE_DIRECTORY=/path/to/training-material/topics/

# Discourse Pipeline Configuration
# Pipeline automatically fetches from ALL categories
DISCOURSE_API_KEY=your-discourse-api-key
DISCOURSE_API_USER=your-username
DISCOURSE_BASE=https://help.galaxyproject.org

# Shared Embedding Configuration
CHROMA_DIRECTORY=./data/embeddings
